# Holocron — mẫu biến môi trường (SPECIFICATION.md §11.2, ADR-008 mục 12).
# File này chỉ chứa placeholder. KHÔNG ghi key thật vào đây và KHÔNG commit file .env có key thật.
#
# Đặt ở gốc repo vì liệt kê biến cho cả backend và frontend.
# - Backend đọc biến từ môi trường tiến trình (os.environ, infrastructure/llm_config.py) và KHÔNG tự đọc file .env.
#   Hãy nạp biến vào shell trước khi chạy uvicorn, ví dụ:
#     PowerShell: $env:HOLOCRON_LLM_API_KEY = "<key của bạn>"
#     bash:       export HOLOCRON_LLM_API_KEY="<key của bạn>"
# - Frontend (Next.js) chỉ dùng HOLOCRON_API_URL; đặt dòng đó trong holocron/frontend/.env.local nếu cần đổi.
# - Biến để trống hoặc chỉ có khoảng trắng được coi như chưa đặt.

# ---------------------------------------------------------------------------
# LLM văn bản: TUỲ CHỌN (SPECIFICATION.md §11.2, §11.4, §11.5).
# Bỏ trống cả nhóm thì app chạy offline; tính năng cần LLM báo không khả dụng qua GET /v1/runtime.
# Endpoint bất kỳ theo giao thức OpenAI Chat Completions; không có nhà cung cấp mặc định.
# Base URL gồm cả phần version (như base_url của OpenAI SDK); adapter tự nối thêm /chat/completions.
# Key hiện tại do ban tổ chức cấp và đi qua gateway của ban tổ chức: văn bản tài liệu gửi LLM
# sẽ rời máy qua gateway đó (§13.1).
# Ví dụ khác (chỉ là ví dụ): https://api.deepseek.com/v1, hoặc một server local tương thích OpenAI.
# Lưu ý: code hiện tại (infrastructure/llm_config.py) vẫn có mặc định DeepSeek khi để trống;
# spec v0.6 bỏ mặc định này (§17 D12).
# ---------------------------------------------------------------------------
HOLOCRON_LLM_BASE_URL=https://<gateway>/v1
HOLOCRON_LLM_API_KEY=
# Tên model của nhà cung cấp bạn dùng, ví dụ model hiện có qua gateway của ban tổ chức.
HOLOCRON_LLM_MODEL_EXTRACT=<tên-model>
# Để trống thì dùng giá trị của HOLOCRON_LLM_MODEL_EXTRACT (đề xuất, §11.2).
HOLOCRON_LLM_MODEL_AUTHOR=
HOLOCRON_LLM_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# VLM tuỳ chọn (model có thị giác, nhận image_url). Cần đủ cả ba biến mới được dùng.
# Đang park (2026-10-25): chưa kiểm gateway hiện có nhận ảnh hay không.
# ---------------------------------------------------------------------------
HOLOCRON_VLM_BASE_URL=
HOLOCRON_VLM_API_KEY=
HOLOCRON_VLM_MODEL=

# ---------------------------------------------------------------------------
# Bộ nhập PDF (ADR-008). Chưa có code đọc các biến này; giá trị dưới đây là mặc định dự kiến.
# Tesseract và vie.traineddata do người dùng tự cài.
# ---------------------------------------------------------------------------
# MVP chỉ nhận "tesseract".
HOLOCRON_PDF_OCR_PRIMARY=tesseract
# Để trống nghĩa là không có lượt đọc thứ hai (cross_check = unavailable).
HOLOCRON_PDF_OCR_SECONDARY=rapidocr
# Đường dẫn binary; mặc định tìm "tesseract" trong PATH.
HOLOCRON_TESSERACT_CMD=tesseract
# Thư mục chứa vie.traineddata; để trống thì dùng thư mục mặc định của bản cài Tesseract.
HOLOCRON_TESSDATA_DIR=

# ---------------------------------------------------------------------------
# Lưu trữ (SPECIFICATION.md §5.13, đã duyệt 2026-10-25; chưa có code đọc biến này).
# Để trống thì dùng %LOCALAPPDATA%\Holocron (Windows) hoặc $XDG_DATA_HOME/holocron (Linux).
# ---------------------------------------------------------------------------
HOLOCRON_DATA_DIR=

# ---------------------------------------------------------------------------
# Bảo mật app local (SPECIFICATION.md §13.1; chưa có code đọc biến này).
# Kiểm Host luôn bật. Đặt biến này thì mọi request phải mang token (chế độ chạy dưới Tauri).
# Đề xuất: giá trị là chính token, do Tauri sinh ngẫu nhiên mỗi lần khởi động; không đặt tay khi chạy webapp.
# Để trống: không yêu cầu token.
# ---------------------------------------------------------------------------
HOLOCRON_REQUIRE_TOKEN=

# ---------------------------------------------------------------------------
# Frontend (holocron/frontend/next.config.ts): địa chỉ backend cho rewrite /api/holocron/*.
# ---------------------------------------------------------------------------
HOLOCRON_API_URL=http://127.0.0.1:8000
