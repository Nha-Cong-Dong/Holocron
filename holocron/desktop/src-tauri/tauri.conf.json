{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holocron",
  "mainBinaryName": "Holocron",
  "identifier": "vn.holocron.desktop",
  "build": { "frontendDist": "../loading" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Holocron",
    "shortDescription": "Holocron",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Vietnamese"] }
    }
  }
}
